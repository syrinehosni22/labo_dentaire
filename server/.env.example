# =====================================================================
#  Laboratoire dentaire : configuration du serveur
#  Copiez ce fichier en .env puis adaptez les valeurs.
#  Les variables d'environnement du système ont priorité sur ce fichier.
# =====================================================================

# --- Serveur ---------------------------------------------------------
# development | production
NODE_ENV=development
PORT=4000
# Adresse du serveur API. L'interface React envoie toutes ses requêtes à
# APP_URL + /api (variable injectée par client/vite.config.js).
# En production : l'adresse publique, ex. https://labo.exemple.tn
APP_URL=http://localhost:4000
# Adresse de l'interface React quand elle ne tourne pas sur APP_URL
# (développement : Vite sur le port 5173). Utilisée pour les liens envoyés
# par e-mail et autorisée en CORS. À laisser vide en production si
# l'interface est servie par le serveur lui-même (npm run build).
CLIENT_URL=http://localhost:5173
# Autres origines autorisées à appeler l'API, séparées par des virgules
CORS_ORIGINS=
# 1 = redirige HTTP vers HTTPS (derrière un proxy qui envoie X-Forwarded-Proto)
FORCE_HTTPS=0

# --- Sécurité --------------------------------------------------------
# Clé de signature des sessions : longue chaîne aléatoire (64+ caractères).
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# La changer déconnecte tous les utilisateurs.
JWT_SECRET=

# --- Premier administrateur ------------------------------------------
# Utilisé uniquement si la base ne contient encore aucun utilisateur.
# Ce mot de passe est provisoire : un nouveau est demandé à la première connexion.
ADMIN_EMAIL=admin@labo.local
ADMIN_PASSWORD=admin1234

# --- Base de données MongoDB ------------------------------------------
# Adresse de connexion. Exemples :
#   MongoDB installé sur ce Mac : mongodb://127.0.0.1:27017/labo_dentaire
#   MongoDB Atlas (en ligne)    : mongodb+srv://UTILISATEUR:MOT_DE_PASSE@cluster0.xxxxx.mongodb.net/labo_dentaire?retryWrites=true&w=majority
# Le nom après le dernier « / » est le nom de la base (créée automatiquement).
MONGODB_URI=mongodb://127.0.0.1:27017/labo_dentaire

# --- Données ---------------------------------------------------------
# Dossier des sauvegardes (fichiers .json.gz), relatif au dossier server/
DATA_DIR=./data

# --- E-mail (SMTP) ---------------------------------------------------
# Sert aux liens « mot de passe oublié » et aux rappels par e-mail.
# Si le serveur SMTP est aussi renseigné dans Paramètres → Notifications,
# c'est ce dernier qui est utilisé.
SMTP_HOST=
SMTP_PORT=587
# 1 pour le port 465 (SSL), 0 pour 587 (STARTTLS)
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Laboratoire dentaire <no-reply@exemple.tn>"

# --- Notifications push (téléphone / navigateur) ---------------------
# Contact affiché aux services push (mailto: ou https:)
VAPID_SUBJECT=mailto:contact@exemple.tn
# Facultatif : si vides, des clés sont générées et stockées dans la base.
# Les fixer ici évite de devoir réabonner les téléphones après une restauration.
# Générer : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
